{$PUBLIC_HOSTNAME} {
	encode gzip
	# Never `app`: on the shared sift-edge network that name also resolves to staging's app.
	reverse_proxy sift-prod-app:3000
}

# Staging app from the sift-staging Compose project, over the shared sift-edge network.
{$STAGING_HOSTNAME:staging.localhost} {
	encode gzip
	reverse_proxy sift-staging-app:3000
}
