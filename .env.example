# Copy to .env and fill in. .env is gitignored; never commit real values.
# Local `docker compose up` works without a .env (dev defaults in compose.yaml).
# Production (compose.prod.yaml) requires every value marked REQUIRED-IN-PROD.

# --- Database ---------------------------------------------------------------
# Postgres credentials used by the db container and to build the app's DATABASE_URL
# inside Compose. REQUIRED-IN-PROD (use a strong password).
POSTGRES_USER=sift
POSTGRES_PASSWORD=sift
POSTGRES_DB=sift

# Connection string for running the app or migrations OUTSIDE Docker (npm run dev / db:migrate).
# Inside Compose this is built automatically from the POSTGRES_* values above.
DATABASE_URL=postgres://sift:sift@localhost:5432/sift

# Database for automated tests. Overrides DATABASE_URL during `npm test`.
# Use a unique database name per worktree (e.g. sift_test_04); it is created automatically.
TEST_DATABASE_URL=postgres://sift:sift@localhost:5432/sift_test

# --- Local host ports (compose.yaml only) -----------------------------------
APP_HOST_PORT=3000
DB_HOST_PORT=5432

# --- AI triage (Google Gemini) ----------------------------------------------
# API key for Gemini. REQUIRED-IN-PROD. Tests never call Gemini.
GEMINI_API_KEY=
# Model id. Small, low-cost model recommended.
GEMINI_MODEL=gemini-3.5-flash-lite
# Maximum provider calls per UTC day across the whole app; protects the spend cap.
AI_DAILY_CAP=450
# Maximum provider calls in any 60 seconds (free tier: 15/min). Set both just below the live AI Studio quota.
AI_RPM_LIMIT=12

# --- Security ---------------------------------------------------------------
# Shared secret the inbound-email sender must send in the webhook header. REQUIRED-IN-PROD.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=change-me
# Key used to sign session cookies (32+ chars). REQUIRED-IN-PROD.
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Mail and environment ---------------------------------------------------
# capture: store mail and show it at /dev/mailbox (dev, staging). fake: in-memory (tests only).
# gmail: send through the dedicated Gmail account. REQUIRED-IN-PROD (production refuses anything else).
MAIL_TRANSPORT=capture
# The dedicated Gmail account and its app password (Google Account > Security > 2-Step
# Verification > App passwords). REQUIRED-IN-PROD. Staging uses the same account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Outside production the gmail transport only mails these addresses (comma-separated) and
# captures everything else. Staging also sets Reply-To to the GMAIL_USER +staging alias.
MAIL_ALLOWED_RECIPIENTS=
# Display name on outgoing mail.
MAIL_FROM_NAME=Sift Support
# development | staging | production. /dev/mailbox never exists in production.
# Unset: compose.yaml uses development, compose.prod.yaml production. A staging stack sets staging.
# APP_ENV=staging

# --- Seeded users (no sign-up)----------------------------------------------
# Accounts: admin@sift.local (admin); alice@, ben@, chloe@, dev@sift.local (agents).
# Hashed with bcrypt by `npm run db:seed` (run automatically by the Compose `migrate` service).
# One password per account. Re-running the seed after changing a value updates that
# account's password (existing users included). All five are REQUIRED-IN-PROD.
SEED_PASSWORD_ADMIN=change-me-admin
SEED_PASSWORD_ALICE=change-me-alice
SEED_PASSWORD_BEN=change-me-ben
SEED_PASSWORD_CHLOE=change-me-chloe
SEED_PASSWORD_DEV=change-me-dev

# --- Production hostname (compose.prod.yaml only) ---------------------------
# Public hostname Caddy serves and gets an HTTPS certificate for.
# Use sslip.io wildcard DNS from the Elastic IP, e.g. 203.0.113.10 -> sift-203-0-113-10.sslip.io
PUBLIC_HOSTNAME=sift-203-0-113-10.sslip.io
# Staging hostname the same Caddy also serves (proxied to the sift-staging project).
# Unset, Caddy uses staging.localhost and asks Let's Encrypt for nothing.
STAGING_HOSTNAME=sift-staging-203-0-113-10.sslip.io
