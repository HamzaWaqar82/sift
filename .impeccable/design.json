      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;height:2.25rem;padding:0 .95rem;font-family:var(--font-display),'Barlow Condensed',sans-serif;font-weight:600;font-size:.8125rem;text-transform:uppercase;letter-spacing:.07em;border-radius:3px;border:1.5px solid #0d1b3d;background:#fff;color:#0d1b3d;cursor:pointer;transition:background-color 160ms ease-out,color 160ms ease-out,border-color 160ms ease-out,transform 120ms ease-out}.ds-btn:hover{background:#0d1b3d;color:#fff}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid #0d1b3d;outline-offset:2px}.ds-btn-off,.ds-btn-off:hover{cursor:not-allowed;background:#f6f7f9;border-color:#4a5370;border-style:dashed;color:#34405e;transform:none}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Ruled field with condensed caps label.",
      "html": "<label class=\"ds-label\" for=\"ds-i\">Customer email</label><input id=\"ds-i\" class=\"ds-input\" placeholder=\"name@example.com\">",
      "css": ".ds-label{display:block;margin-bottom:.3rem;font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:#34405e}.ds-input{display:block;width:100%;min-height:2.5rem;padding:.5rem .75rem;font:inherit;font-size:.9375rem;color:#0d1b3d;background:#fff;border:1px solid #4a5370;border-radius:3px;transition:border-color 160ms ease-out,box-shadow 160ms ease-out}.ds-input::placeholder{color:#666d83}.ds-input:hover{border-color:#0d1b3d}.ds-input:focus{outline:none;border-color:#0d1b3d;box-shadow:0 0 0 1px #0d1b3d}"
    },
