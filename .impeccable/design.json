      "css": ".ds-tabrow{display:flex;gap:.25rem;padding-left:1rem;margin-bottom:-1px;position:relative;z-index:1}.ds-tab{display:inline-flex;align-items:center;height:1.625rem;padding:0 .875rem;font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:#0d1b3d;background:#fff;border:1px solid #0d1b3d;border-bottom:0;clip-path:polygon(7px 0,calc(100% - 7px) 0,100% 7px,100% 100%,0 100%,0 7px)}.ds-tab-navy{background:#0d1b3d;color:#fff}.ds-tab-red{background:#d7262d;border-color:#d7262d;color:#fff}.ds-coupon-edge{height:24px;border:1px solid #0d1b3d;border-bottom:0;border-radius:4px 4px 0 0;background:#fff}"
