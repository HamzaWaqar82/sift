      "css": ".ds-cc{background:#d9cfee;border:1px solid rgb(75 46 131/.4);border-radius:4px;padding:1rem;display:flex;justify-content:flex-end}.ds-rubber{display:inline-flex;flex-direction:column;padding:.3rem .6rem .35rem;border:2px solid #0d1b3d;outline:1px solid #0d1b3d;outline-offset:2px;border-radius:3px;transform:rotate(-5deg);font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;line-height:1;color:#0d1b3d;transition:transform 240ms cubic-bezier(.16,1,.3,1)}.ds-rubber:hover{transform:rotate(-3deg) scale(1.03)}.ds-rw{font-weight:700;font-size:1.35rem;letter-spacing:.12em}.ds-rm{margin-top:.2rem;font-weight:600;font-size:.6875rem;letter-spacing:.06em}.ds-mono{font-family:'JetBrains Mono',monospace;text-transform:none;letter-spacing:0}"
